# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e configure com seus valores

# ===== CONFIGURAÇÕES DO SERVIDOR =====
PORT=3000
HOST=localhost
NODE_ENV=development

# ===== BANCO DE DADOS =====
# OBRIGATÓRIO: Configure sua string de conexão MongoDB
MONGODB_URI=mongodb://localhost:27017/walletDatabase
# Para MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/walletDatabase

# ===== SEGURANÇA JWT =====
# OBRIGATÓRIO EM PRODUÇÃO: Gere uma chave secreta forte
JWT_SECRET=sua-chave-jwt-super-secreta-aqui-min-32-caracteres
JWT_EXPIRES_IN=24h

# ===== SESSÃO =====
# OBRIGATÓRIO EM PRODUÇÃO: Gere uma chave secreta forte  
SESSION_SECRET=sua-chave-sessao-super-secreta-aqui-min-32-caracteres
SESSION_MAX_AGE=86400000

# ===== CORS =====
# Defina os domínios permitidos separados por vírgula
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://seu-dominio.com

# ===== YAHOO FINANCE API =====
YF_TIMEOUT=10000
YF_RETRIES=3

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ===== CACHE =====
CACHE_TIMEOUT=600000

